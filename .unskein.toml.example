# Copy to .unskein.toml (gitignored). Env vars take precedence over this file.

[general]
lang = "en"            # "es" | "en"

[ai]
model = "ollama/qwen2.5-coder:7b"
api_base = "http://localhost:11434"
# api_key = ""         # prefer UNSKEIN_API_KEY env var

[analysis]
parallel_threshold = 50
# max_workers = 8      # default: os.cpu_count()
queue_maxsize = 200
max_file_size_bytes = 5242880
per_file_timeout_seconds = 30
# default_encoding = "utf-8"   # fallback only, never overrides a PEP 263 cookie
