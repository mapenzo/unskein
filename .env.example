# Copy to .env and fill in. Never commit .env.
# unskein reads environment variables, not this file: load it in your shell
# first (set -a; source .env; set +a), or with a tool such as direnv.
# Precedence: env var > .unskein.toml / ~/.config/unskein/config.toml > --api-key flag.
# Provider recipes (OpenAI, Claude, Azure, Bedrock, proxies...): unskein guide

# LiteLLM model string, e.g. "ollama/qwen2.5-coder:7b" or "openai/gpt-4o-mini"
UNSKEIN_AI_MODEL=
# Optional: when empty, LiteLLM reads the provider's own variable
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, AZURE_API_KEY...).
UNSKEIN_API_KEY=
# Only for local servers, Azure and LiteLLM proxies.
UNSKEIN_AI_API_BASE=

# "es" | "en" (default: system locale, falls back to English)
UNSKEIN_LANG=
